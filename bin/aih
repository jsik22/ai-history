#!/usr/bin/env python3
"""Search complete raw conversation blocks in the local private archive."""
import argparse
import datetime
import os
from pathlib import Path
import re
import sys

HEADER = re.compile(r'^===== [0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} \| ')


def count(value):
    if not re.fullmatch(r'[0-9]+', value):
        raise argparse.ArgumentTypeError('개수는 0 이상의 정수여야 합니다')
    return int(value)


def blocks(path):
    current = []
    with path.open(encoding='utf-8', newline='') as source:
        for line in source:
            if HEADER.match(line):
                if current:
                    yield ''.join(current)
                current = [line]
            elif current:
                current.append(line)
    if current:
        yield ''.join(current)


def main(argv=None):
    parser = argparse.ArgumentParser(
        description='일치하는 대화 블록을 출력합니다. 인자가 없으면 오늘 기록을 출력합니다.')
    parser.add_argument('-p', default='', metavar='프로젝트', help='작업 디렉터리에 포함된 문자열')
    parser.add_argument('-d', default='', metavar='날짜', help='날짜 접두사 (예: 2026-10)')
    parser.add_argument('-t', default='', choices=['claude', 'codex'], help='대화 도구')
    parser.add_argument('-n', type=count, default=0, metavar='개수', help='파일 순서상 마지막 N개 (0은 전체)')
    parser.add_argument('-l', action='store_true', help='헤더와 프롬프트 첫 줄만 출력')
    parser.add_argument('keywords', nargs='*', help='모두 포함되어야 하는 문자열 (대소문자 무시)')
    args = parser.parse_args(argv)
    if not args.keywords and not (args.p or args.d or args.t) and args.n == 0:
        args.d = datetime.date.today().isoformat()
    root = Path(os.environ.get('AI_HISTORY_DIR') or str(Path.home() / '.ai_history'))
    keywords = [word.lower() for word in args.keywords]
    matches = []
    paths = []
    for folder, directories, filenames in os.walk(root):
        directories[:] = [name for name in directories if not name.startswith('.')]
        for name in filenames:
            if not name.startswith('.') and name.startswith(args.d) and name.endswith('.md'):
                paths.append(Path(folder) / name)
    for path in sorted(paths):
        for block in blocks(path):
            lines = block.split('\n')
            header = lines[0]
            fields = header.split(' | ')
            if len(fields) < 3:
                continue
            if args.t and fields[1] != args.t:
                continue
            if args.p and args.p not in fields[2]:
                continue
            lower = block.lower()
            if not all(word in lower for word in keywords):
                continue
            if args.l:
                matches.append(header + '\n' + (lines[1] if len(lines) > 1 else '') + '\n')
            else:
                matches.append(block)
    for match in matches[-args.n:] if args.n else matches:
        sys.stdout.write(match)
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except BrokenPipeError:
        os._exit(0)
    except (OSError, UnicodeError) as exc:
        print(f'aih: {exc}', file=sys.stderr)
        raise SystemExit(1)
